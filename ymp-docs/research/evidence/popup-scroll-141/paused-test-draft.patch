+/// The screen as drawn cells.
+fn drawn(app: &mut App, width: u16, height: u16) -> ratatui::buffer::Buffer {
+    let mut terminal = Terminal::new(TestBackend::new(width, height)).unwrap();
+    terminal.draw(|frame| ui::render(frame, app)).unwrap();
+    terminal.backend().buffer().clone()
+}
+
+/// The rect of the floating surface whose top border carries `badge`, read from its corners.
+fn surface_rect(buffer: &ratatui::buffer::Buffer, badge: &str) -> ratatui::layout::Rect {
+    let area = buffer.area;
+    let (_, top) = cell_of(buffer, badge).unwrap_or_else(|| panic!("{badge} is not drawn"));
+    let left = (0..area.width)
+        .find(|&x| buffer[(x, top)].symbol() == "┌")
+        .expect("the surface has a top left corner");
+    let right = (left + 1..area.width)
+        .find(|&x| buffer[(x, top)].symbol() == "┐")
+        .expect("the surface has a top right corner");
+    let bottom = (top + 1..area.height)
+        .find(|&y| buffer[(left, y)].symbol() == "└")
+        .expect("the surface has a bottom left corner");
+    ratatui::layout::Rect::new(left, top, right - left + 1, bottom - top + 1)
+}
+
+/// The body rows of a read-only surface: inside its border, above the blank row and its keys.
+fn surface_body(buffer: &ratatui::buffer::Buffer, rect: ratatui::layout::Rect) -> Vec<String> {
+    (rect.y + 1..rect.bottom().saturating_sub(3))
+        .map(|y| {
+            (rect.x + 1..rect.right() - 1)
+                .map(|x| buffer[(x, y)].symbol())
+                .collect::<String>()
+        })
+        .collect()
+}
+
+/// The number after `label` on a body row, such as 7 in `row 007`.
+fn numbered(row: &str, label: &str) -> Option<usize> {
+    let rest = &row[row.find(label)? + label.len()..];
+    rest.split(|c: char| !c.is_ascii_digit())
+        .next()
+        .and_then(|digits| digits.parse().ok())
+}
