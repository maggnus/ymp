+#[test]
+fn an_inspect_surface_keeps_its_size_for_long_short_and_empty_records() {
+    let fixture = fixture();
+    let mut app = fixture.app();
+    app.theme = theme::resolved(theme::DEFAULT_THEME, theme::ASCII);
+    let (width, height) = (100, 30);
+    let line = |n: usize| {
+        ratatui::text::Line::from(if n % 2 == 0 {
+            format!("entry {n:02} — ✓ 日本語")
+        } else {
+            format!("entry {n:02} - ascii")
+        })
+    };
+    let rows = crate::frame::modal_body_rows(height, true);
+    for count in [60, rows, rows + 1, 3, 1, 0] {
+        app.overlay = Some(Overlay::Inspect {
+            title: "Record".into(),
+            body: (1..=count).map(line).collect(),
+            scroll: 0,
+        });
+        let buffer = drawn(&mut app, width, height);
+        let opened = surface_rect(&buffer, "read only");
+        let shown = count.min(rows);
+        assert_eq!(opened.height as usize, shown + 4, "{count} lines");
+        let expected = |body: &[String], last: usize| {
+            assert_eq!(body.len(), shown, "{count} lines");
+            if shown > 0 {
+                assert_eq!(numbered(&body[shown - 1], "entry "), Some(last), "{body:?}");
+                assert!(body.iter().all(|row| !row.trim().is_empty()), "{body:?}");
+            }
+        };
+        let keys = [
+            (KeyCode::End, count),
+            (KeyCode::Up, count.saturating_sub(1).max(shown)),
+            (KeyCode::Down, count),
+            (KeyCode::Char('k'), count.saturating_sub(1).max(shown)),
+            (KeyCode::Char('j'), count),
+            (KeyCode::PageUp, count.saturating_sub(rows).max(shown)),
+            (KeyCode::PageDown, count),
+            (KeyCode::Home, shown),
+        ];
+        for (code, last) in keys {
+            assert!(app.on_key(key(code), width).is_empty());
+            let buffer = drawn(&mut app, width, height);
+            assert_eq!(surface_rect(&buffer, "read only"), opened, "{count} lines, {code:?}");
+            expected(&surface_body(&buffer, opened), last);
+        }
+        assert!(app.on_key(key(KeyCode::Esc), width).is_empty());
+        assert!(app.overlay.is_none());
+    }
+}
