+#[test]
+fn a_file_preview_keeps_its_size_while_it_scrolls_to_its_last_line() {
+    let fixture = fixture();
+    let root = fixture.project.path();
+    let text: String = (1..=120)
+        .map(|n| {
+            if n % 3 == 0 {
+                format!("row {n:03} строка ✓ 表格\n")
+            } else {
+                format!("row {n:03} plain ascii\n")
+            }
+        })
+        .collect();
+    std::fs::write(root.join("notes.txt"), &text).unwrap();
+    let mut app = fixture.app();
+    let config = serde_json::to_string(&app.config).unwrap();
+    let before = tree(root);
+    app.command("/files", FILES_SCREEN.0);
+    select_file_row(&mut app, "notes.txt");
+    let mut actions = app.on_key(key(KeyCode::Enter), FILES_SCREEN.0);
+    assert!(matches!(app.overlay, Some(Overlay::Preview { .. })));
+
+    let (width, height) = FILES_SCREEN;
+    let buffer = drawn(&mut app, width, height);
+    let opened = surface_rect(&buffer, "read only");
+    let first = surface_body(&buffer, opened);
+    assert!(first[0].contains("Plain text · 120 lines"), "{first:?}");
+    let rows = first.len();
+
+    // One row at a time down past the end: the surface never changes, and the view stops with
+    // the last line on the last row rather than leaving blank rows below it.
+    for _ in 0..140 {
+        actions.extend(app.on_key(key(KeyCode::Down), width));
+        let buffer = drawn(&mut app, width, height);
+        assert_eq!(surface_rect(&buffer, "read only"), opened, "scrolling resized it");
+    }
+    let body = surface_body(&drawn(&mut app, width, height), opened);
+    assert_eq!(body.len(), rows);
+    assert!(body[rows - 1].contains("row 120 строка ✓ 表格"), "{body:?}");
+    assert!(body.iter().all(|row| !row.trim().is_empty()), "{body:?}");
+
+    // Presses past the end were not stored: the first Up moves the view.
+    app.on_key(key(KeyCode::Up), width);
+    let body = surface_body(&drawn(&mut app, width, height), opened);
+    assert_eq!(numbered(&body[rows - 1], "row "), Some(119), "{body:?}");
+
+    // A page is the rows the surface shows, so paging skips no line and repeats none.
+    app.on_key(key(KeyCode::Home), width);
+    let mut last = numbered(&surface_body(&drawn(&mut app, width, height), opened)[rows - 1], "row ");
+    for _ in 0..3 {
+        app.on_key(key(KeyCode::PageDown), width);
+        let buffer = drawn(&mut app, width, height);
+        assert_eq!(surface_rect(&buffer, "read only"), opened);
+        let body = surface_body(&buffer, opened);
+        assert_eq!(numbered(&body[0], "row "), last.map(|n| n + 1), "{body:?}");
+        last = numbered(&body[rows - 1], "row ");
+    }
+    app.on_key(key(KeyCode::PageDown), width);
+    let body = surface_body(&drawn(&mut app, width, height), opened);
+    assert_eq!(numbered(&body[rows - 1], "row "), Some(120), "{body:?}");
+    let top = numbered(&body[0], "row ").unwrap();
+    app.on_key(key(KeyCode::PageUp), width);
+    let body = surface_body(&drawn(&mut app, width, height), opened);
+    assert_eq!(numbered(&body[rows - 1], "row "), Some(top - 1), "{body:?}");
+
+    // A resize may change the size, and the end stays on the last row at either size.
+    app.on_key(key(KeyCode::End), width);
+    for tall in [30, 60, 40] {
+        let buffer = drawn(&mut app, width, tall);
+        let rect = surface_rect(&buffer, "read only");
+        let body = surface_body(&buffer, rect);
+        assert_eq!(body.len(), crate::frame::modal_body_rows(tall, true), "at {tall} rows");
+        assert!(body.last().unwrap().contains("row 120"), "at {tall} rows: {body:?}");
+        assert!(body.iter().all(|row| !row.trim().is_empty()), "at {tall} rows: {body:?}");
+    }
+    let buffer = drawn(&mut app, width, 60);
+    app.on_key(key(KeyCode::Up), width);
+    let buffer_after = drawn(&mut app, width, 60);
+    let rect = surface_rect(&buffer, "read only");
+    assert_eq!(surface_rect(&buffer_after, "read only"), rect);
+    let body = surface_body(&buffer_after, rect);
+    assert_eq!(numbered(body.last().unwrap(), "row "), Some(119), "{body:?}");
+
+    // Viewing wrote nothing, and Ctrl+C still leaves from the scrolled preview.
+    assert!(actions.is_empty(), "{actions:?}");
+    assert_eq!(app.on_key(control('c'), width), Vec::<Action>::new());
+    assert_eq!(app.on_key(control('c'), width), vec![Action::Quit]);
+    assert_eq!(serde_json::to_string(&app.config).unwrap(), config);
+    assert_eq!(tree(root), before, "viewing changed the project");
+}
